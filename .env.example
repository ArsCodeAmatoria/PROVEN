# Application
# Local: http://localhost:3000 | Vercel: https://proven-saas.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Proven

# Database (Supabase Postgres connection string)
# Same project for local and production. Append ?sslmode=require&uselibpqcompat=true for Node/pg SSL.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?schema=public&sslmode=require&uselibpqcompat=true
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?schema=public&sslmode=require&uselibpqcompat=true

# Supabase Auth — one shared project for local + Vercel (Proven and Pull use the same keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
