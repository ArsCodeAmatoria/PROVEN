generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application roles for Proven CMS RBAC.
enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  INSTRUCTOR
  SUPERVISOR
  APPRENTICE
  OPERATOR
  READ_ONLY
}

enum CompetencyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssessmentOutcome {
  NOT_STARTED
  IN_PROGRESS
  COMPETENT
  NOT_YET_COMPETENT
  REQUIRES_REVIEW
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  VOIDED
}

enum ApprenticeshipStatus {
  ACTIVE
  PAUSED
  COMPLETED
  WITHDRAWN
}

enum ObservationRating {
  EXCEEDS
  MEETS
  DEVELOPING
  DOES_NOT_MEET
}

enum CertificationStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING
}

enum ContinuousAssessmentType {
  PRACTICAL
  WRITTEN
  OBSERVATION
  PORTFOLIO
  ORAL
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// A construction company / employer account.
/// A company can have unlimited employee profiles.
model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  website   String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles         Profile[]
  invites          CompanyInvite[]
  competencies     Competency[]
  exams            WrittenExam[]
  apprenticeships  Apprenticeship[]
  certifications   Certification[]
  assessments      ContinuousAssessment[]

  @@map("companies")
}

/// App user profile linked 1:1 to Supabase Auth (`auth.users`).
model Profile {
  id          String    @id @default(cuid())
  authUserId  String    @unique
  companyId   String?
  email       String
  firstName   String
  lastName    String
  role        UserRole  @default(READ_ONLY)
  title       String?
  avatarUrl   String?
  phone       String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company                 Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  settings                UserSettings?
  invitesSent             CompanyInvite[]         @relation("InviteSender")
  competencyAssessments   CompetencyAssessment[]  @relation("Assessee")
  assessmentsConducted    CompetencyAssessment[]  @relation("Assessor")
  examAttempts            ExamAttempt[]
  apprenticeships         Apprenticeship[]        @relation("Apprentice")
  supervisedApprentices   Apprenticeship[]        @relation("Mentor")
  observationsReceived    InstructorObservation[] @relation("Observed")
  observationsGiven       InstructorObservation[] @relation("Observer")
  certifications          Certification[]
  continuousAssessments   ContinuousAssessment[]  @relation("Assessee")
  continuousAssessedBy    ContinuousAssessment[]  @relation("Assessor")

  @@index([companyId])
  @@index([email])
  @@index([role])
  @@map("profiles")
}

/// Per-user preferences (notifications, locale, defaults).
model UserSettings {
  id                  String   @id @default(cuid())
  profileId           String   @unique
  emailNotifications  Boolean  @default(true)
  assessmentReminders Boolean  @default(true)
  rememberMeDefault   Boolean  @default(true)
  timezone            String   @default("America/New_York")
  locale              String   @default("en-US")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Invite an employee into a company with a predetermined role.
model CompanyInvite {
  id          String      @id @default(cuid())
  companyId   String
  email       String
  role        UserRole    @default(OPERATOR)
  token       String      @unique @default(cuid())
  status      InviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy Profile @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([companyId, email, status])
  @@index([token])
  @@index([companyId])
  @@map("company_invites")
}

model Competency {
  id          String           @id @default(cuid())
  companyId   String
  code        String
  title       String
  description String
  category    String
  trade       String
  level       Int              @default(1)
  status      CompetencyStatus @default(DRAFT)
  version     Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  criteria    CompetencyCriterion[]
  assessments CompetencyAssessment[]
  examLinks   ExamCompetency[]
  progress    ApprenticeshipProgress[]

  @@unique([companyId, code, version])
  @@index([companyId, status])
  @@index([trade, category])
  @@map("competencies")
}

model CompetencyCriterion {
  id           String  @id @default(cuid())
  competencyId String
  description  String
  sortOrder    Int     @default(0)
  isCritical   Boolean @default(false)

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@index([competencyId])
  @@map("competency_criteria")
}

model CompetencyAssessment {
  id            String            @id @default(cuid())
  competencyId  String
  assesseeId    String
  assessorId    String
  outcome       AssessmentOutcome @default(NOT_STARTED)
  evidenceNotes String?
  assessedAt    DateTime?
  validUntil    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  assessee   Profile    @relation("Assessee", fields: [assesseeId], references: [id], onDelete: Cascade)
  assessor   Profile    @relation("Assessor", fields: [assessorId], references: [id], onDelete: Restrict)

  @@index([competencyId])
  @@index([assesseeId])
  @@index([assessorId])
  @@index([outcome])
  @@map("competency_assessments")
}

model WrittenExam {
  id           String     @id @default(cuid())
  companyId    String
  code         String
  title        String
  description  String?
  status       ExamStatus @default(DRAFT)
  passingScore Int        @default(70)
  timeLimitMin Int?
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  questions    ExamQuestion[]
  attempts     ExamAttempt[]
  competencies ExamCompetency[]

  @@unique([companyId, code, version])
  @@index([companyId, status])
  @@map("written_exams")
}

model ExamCompetency {
  examId       String
  competencyId String

  exam       WrittenExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  competency Competency  @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([examId, competencyId])
  @@map("exam_competencies")
}

model ExamQuestion {
  id           String @id @default(cuid())
  examId       String
  prompt       String
  options      Json
  correctIndex Int
  points       Int    @default(1)
  sortOrder    Int    @default(0)

  exam WrittenExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@map("exam_questions")
}

model ExamAttempt {
  id          String            @id @default(cuid())
  examId      String
  profileId   String
  status      ExamAttemptStatus @default(IN_PROGRESS)
  score       Int?
  answers     Json?
  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?

  exam    WrittenExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  profile Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([profileId])
  @@index([status])
  @@map("exam_attempts")
}

model Apprenticeship {
  id             String               @id @default(cuid())
  companyId      String
  apprenticeId   String
  mentorId       String?
  programName    String
  trade          String
  startDate      DateTime
  targetEndDate  DateTime?
  status         ApprenticeshipStatus @default(ACTIVE)
  hoursRequired  Int                  @default(2000)
  hoursCompleted Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  company      Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  apprentice   Profile                 @relation("Apprentice", fields: [apprenticeId], references: [id], onDelete: Cascade)
  mentor       Profile?                @relation("Mentor", fields: [mentorId], references: [id], onDelete: SetNull)
  progress     ApprenticeshipProgress[]
  observations InstructorObservation[]

  @@index([companyId])
  @@index([apprenticeId])
  @@index([status])
  @@map("apprenticeships")
}

model ApprenticeshipProgress {
  id               String            @id @default(cuid())
  apprenticeshipId String
  competencyId     String
  outcome          AssessmentOutcome @default(NOT_STARTED)
  notes            String?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  apprenticeship Apprenticeship @relation(fields: [apprenticeshipId], references: [id], onDelete: Cascade)
  competency     Competency     @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([apprenticeshipId, competencyId])
  @@index([apprenticeshipId])
  @@map("apprenticeship_progress")
}

model InstructorObservation {
  id               String            @id @default(cuid())
  apprenticeshipId String?
  observedId       String
  observerId       String
  context          String
  rating           ObservationRating
  notes            String
  observedAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  apprenticeship Apprenticeship? @relation(fields: [apprenticeshipId], references: [id], onDelete: SetNull)
  observed       Profile         @relation("Observed", fields: [observedId], references: [id], onDelete: Cascade)
  observer       Profile         @relation("Observer", fields: [observerId], references: [id], onDelete: Restrict)

  @@index([observedId])
  @@index([observerId])
  @@index([apprenticeshipId])
  @@map("instructor_observations")
}

model Certification {
  id           String              @id @default(cuid())
  companyId    String
  profileId    String
  name         String
  issuer       String
  credentialId String?
  status       CertificationStatus @default(PENDING)
  issuedAt     DateTime?
  expiresAt    DateTime?
  documentUrl  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([profileId])
  @@index([status])
  @@index([expiresAt])
  @@map("certifications")
}

model ContinuousAssessment {
  id          String                   @id @default(cuid())
  companyId   String
  assesseeId  String
  assessorId  String
  type        ContinuousAssessmentType
  title       String
  description String?
  outcome     AssessmentOutcome        @default(NOT_STARTED)
  score       Int?
  maxScore    Int?
  feedback    String?
  assessedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assessee Profile @relation("Assessee", fields: [assesseeId], references: [id], onDelete: Cascade)
  assessor Profile @relation("Assessor", fields: [assessorId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([assesseeId])
  @@index([type])
  @@map("continuous_assessments")
}
